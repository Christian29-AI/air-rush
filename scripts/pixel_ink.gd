}

static func width(message: String, scale_px: int) -> float:
 var total := 0
 for letter in message.to_upper():
  total += (GLYPHS.get(letter, "000").split("/")[0].length() + 1) * scale_px
 return float(maxi(0, total - scale_px))

static func text(canvas: CanvasItem, message: String, pos: Vector2, scale_px: int, color: Color, centered: bool = false) -> void:
 var origin := pos.round()
 if centered:
  origin.x -= floorf(width(message, scale_px) / 2.0)
 for letter in message.to_upper():
  var rows: PackedStringArray = GLYPHS.get(letter, "000/000/000/000/000/000/000").split("/")
  for y in rows.size():
   for x in rows[y].length():
    if rows[y][x] == "1":
     canvas.draw_rect(Rect2(origin + Vector2(x, y) * scale_px, Vector2.ONE * scale_px), color)
  origin.x += (rows[0].length() + 1) * scale_px

static func panel(canvas: CanvasItem, rect: Rect2, fill: Color, edge: Color, thickness: float = 2.0) -> void:
 canvas.draw_rect(rect, fill)
 canvas.draw_rect(rect, edge, false, thickness)
